APP_NAME=rust-api
APP_URL=0.0.0.0
APP_PORT=8000

DATABASE_URL=postgres://appuser:change_me_postgres_pass@localhost:5432/appdb

# Garage S3 (attachments). Provision locally with:
#   docker exec garage /garage layout assign -z dc1 -c 1G <node-id>
#   docker exec garage /garage layout apply --version 1
#   docker exec garage /garage key create eat-app
#   docker exec garage /garage bucket create eat-attachments
#   docker exec garage /garage bucket allow --read --write --owner eat-attachments --key eat-app
GARAGE_ENDPOINT=http://localhost:3900
GARAGE_BUCKET=eat-attachments
GARAGE_REGION=garage
GARAGE_ACCESS_KEY_ID=
GARAGE_SECRET_ACCESS_KEY=
